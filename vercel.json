{
  "version": 2,
  "functions": {
    "api/gdrive.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/data.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
