# Google Drive API — Vercel Environment Variables
# Set these in Vercel Dashboard → Settings → Environment Variables

# 1. Service Account JSON (paste the entire JSON as a single string)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 2. Google Drive Folder ID (create a root folder, copy its ID from the URL)
#    Example: https://drive.google.com/drive/folders/abc123xyz → Folder ID is "abc123xyz"
GOOGLE_DRIVE_FOLDER_ID=abc123xyz
